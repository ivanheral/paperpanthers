{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Paper Panthers",
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"name": "Panther Black",
					"slug": "pp-black",
					"color": "#111111"
				},
				{
					"name": "Paper White",
					"slug": "pp-white",
					"color": "#FAFAF8"
				},
				{
					"name": "Acid Lime",
					"slug": "pp-lime",
					"color": "#B6FF00"
				},
				{
					"name": "Electric Blue",
					"slug": "pp-blue",
					"color": "#0060FF"
				},
				{
					"name": "Base",
					"slug": "base",
					"color": "#FAFAF8"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#111111"
				},
				{
					"name": "Accent 1",
					"slug": "accent-1",
					"color": "#B6FF00"
				},
				{
					"name": "Accent 2",
					"slug": "accent-2",
					"color": "#0060FF"
				}
			]
		},
		"layout": {
			"contentSize": "1100px",
			"wideSize": "1200px"
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Arial, Helvetica, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"name": "Sans",
					"slug": "sans"
				},
				{
					"fontFamily": "'Courier New', Courier, monospace",
					"name": "Monospace",
					"slug": "monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "13px",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "16px",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "24px",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "clamp(32px, 5vw, 48px)",
					"slug": "x-large"
				},
				{
					"name": "Huge",
					"size": "clamp(42px, 8vw, 96px)",
					"slug": "huge"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#FAFAF8",
			"text": "#111111"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "16px",
			"lineHeight": "1.5"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "900",
					"letterSpacing": "-0.03em"
				},
				"color": {
					"text": "#111111"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(42px, 8vw, 96px)",
					"letterSpacing": "-0.04em",
					"lineHeight": "0.95"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(24px, 4vw, 38px)",
					"letterSpacing": "-0.03em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "22px",
					"letterSpacing": "-0.02em"
				}
			},
			"button": {
				"border": {
					"radius": "0px",
					"width": "2px",
					"style": "solid",
					"color": "#111111"
				},
				"color": {
					"background": "#B6FF00",
					"text": "#111111"
				},
				"typography": {
					"fontWeight": "800",
					"letterSpacing": "1px",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				":hover": {
					"color": {
						"text": "#0060FF"
					}
				}
			}
		}
	}
}
